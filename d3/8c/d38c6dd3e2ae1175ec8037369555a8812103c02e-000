# 8 October 2026: 3 music fade-in tests (easeOutBack 0.25 / 0.5 / 1 s) on the first 5 s, music from 3:36.
import numpy as np, subprocess, sys
d=float(sys.argv[1]); SR=48000; START=216; DUR=5
raw=subprocess.run(['ffmpeg','-v','error','-ss',str(START),'-t',str(DUR),'-i','music/in-spite-of-everything.mp3','-af','loudnorm=I=-16:TP=-1.5','-ar',str(SR),'-ac','2','-f','f32le','-'],capture_output=True,check=True).stdout
x=np.frombuffer(raw,np.float32).reshape(-1,2).copy(); t=np.arange(len(x))/SR
u=np.clip(t/d,0,1); c1=1.70158; c3=c1+1; env=1+c3*(u-1)**3+c1*(u-1)**2   # easeOutBack: overshoots ~1.1 then settles at 1
x*=(env*0.92)[:,None]; x=np.clip(x,-0.99,0.99)
subprocess.run(['ffmpeg','-v','error','-y','-i','intro_easeOutBack_0.5s.mp4','-f','f32le','-ar',str(SR),'-ac','2','-i','-','-map','0:v','-map','1:a','-c:v','copy','-c:a','aac','-b:a','192k','-shortest',f'intro_music_fade_{d}s.mp4'],input=x.tobytes(),check=True)
print('ok',d)
