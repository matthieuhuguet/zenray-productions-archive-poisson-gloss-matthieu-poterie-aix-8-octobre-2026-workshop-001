# 8 October 2026: roughness meter = how much fast, random envelope wobble a sound has (what the ear hears as "grésille").
import numpy as np, soundfile as sf
from scipy.signal import butter, sosfiltfilt, hilbert
def rough(m,sr,t0,t1,band=(400,1600)):
    x=m[int(t0*sr):int(t1*sr)]; y=sosfiltfilt(butter(4,band,'bp',fs=sr,output='sos'),x); e=np.abs(hilbert(y))+1e-9
    k=int(.03*sr); s=np.convolve(e,np.ones(k)/k,'same'); r=(e-s)[k:-k]; return float(np.std(r)/np.mean(s[k:-k]))
def hfgrain(m,sr,t0,t1):  # energy above 1.8k in dB relative to the whole segment
    x=m[int(t0*sr):int(t1*sr)]; F=np.abs(np.fft.rfft(x*np.hanning(len(x))))**2; f=np.fft.rfftfreq(len(x),1/sr); return float(10*np.log10(F[f>1800].sum()/F.sum()+1e-15))
def report(name,path,wins=((0.2,1.1,'swell'),(1.6,2.6,'body'),(2.8,4.6,'tail'))):
    x,sr=sf.read(path); m=x.mean(1) if x.ndim>1 else x
    print(f'{name:22s}',' | '.join(f'{lab} R={rough(m,sr,a,b):.3f} HF={hfgrain(m,sr,a,b):.0f}dB' for a,b,lab in wins))
if __name__=='__main__':
    import sys
    for p in sys.argv[1:]: report(p.split('/')[-1][:-4],p)
