# 8 October 2026: 3 variations built FROM P2 (original + soft tap + low bowl + silky hall). Smooth, no grain, close to source.
import sys; sys.path.insert(0,'Scripts')
import numpy as np
from scipy.signal import butter, sosfilt
import MakeVariants as M, MakeSimple as S
SR=M.SR; F=M.F
def build(name,tap,bowl,hall,rt,tail,echo=None,tap_f=190):
    o=S.base(); n=o.shape[1]/SR+rt+0.3
    b=M.make(n); b[:,:o.shape[1]]+=o
    if echo:  # damped tape-like echoes of the original (addictive ping-pong), darker each repeat
        for k,(dt,g,lp) in enumerate(echo):
            e=sosfilt(butter(2,lp,'lp',fs=SR,output='sos'),o,axis=1); i=int(dt*SR)
            b[0,i:i+e.shape[1]]+=g*e[0][:b.shape[1]-i]; b[1,i:i+e.shape[1]]+=g*e[1][:b.shape[1]-i]  # same channel (stays centered)
            b[:,i:i+e.shape[1]]=b[:,i:i+e.shape[1]]  # no-op for clarity
    if tap: M.place(b,M.tsuzumi_tap(f=tap_f),0,tap,0)
    for f,at,g in bowl: M.place(b,M.rin(f,3.5),at,g,0)
    b=S.silk_hall(b,hall,rt)
    return M.finalize(b,name,tail,lp=8500)
if __name__=='__main__':
    # Q1 satisfying: P2 with a firmer, rounder tap + warm bowl
    build('Q1_Satisfying',tap=.16,bowl=[(F['C5']/2,0.0,.12)],hall=.24,rt=1.6,tail=.6,tap_f=170)
    # Q2 addictive: P2 + two soft darker echoes of the original (second 'ping' invites replay)
    build('Q2_Addictive',tap=.10,bowl=[(F['C5']/2,0.0,.10)],hall=.24,rt=1.8,tail=.8,echo=[(0.22,.22,2500),(0.44,.10,1800)])
    # Q3 relaxing: P2 with a bowl fifth (C4 + G4), longer silky tail, softer tap
    build('Q3_Relaxing',tap=.07,bowl=[(F['C5']/2,0.0,.11),(F['G5']/2,0.05,.07)],hall=.32,rt=2.4,tail=1.2)
    print('ok')
